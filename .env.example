# Neon の接続文字列（Connection pooling はオフ＝直接接続）
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# ログイン用の署名キー。32文字以上のランダムな文字列
AUTH_SECRET=

# 管理者にするメールアドレス（カンマ区切り）。このメールで会員登録すると管理者になる
ADMIN_EMAILS=

# AI評価用（Anthropic APIキー）。未設定でもアプリは動くが、AI評価だけ使えない
ANTHROPIC_API_KEY=
# 任意: AIモデル名（省略時は claude-sonnet-5-5）
AI_MODEL=
